---
const ancorStyle:string = "decoration-slate-500 hover:underline underline-offset-4"
---

<script>
    
    const header = document.getElementById('top')
    const sobreMiContainer = document.getElementById('sobre-mi')

    if (header) {
        let ticking = false

        window.addEventListener('scroll', () => {
            if (!ticking) {
                requestAnimationFrame(() => {
                    header.classList.toggle('scrolled', window.scrollY > 0)
                    sobreMiContainer?.classList.toggle('scrolled', window.scrollY > 0)
                    ticking = false
                })
                ticking = true
            }
        })
    }

</script>

<header id="top" class="flex justify-evenly items-center py-2 px-8 mx-8 top-1 fixed bg-transparent backdrop-blur-lg backdrop-brightness-90 rounded-xl w-[-webkit-fill-available] max-[550px]:px-4 max-[550px]:mx-3 z-10">
    <img class="rounded-full w-12 h-12 max-sm:mr-5 aspect-square object-cover" src="PFP.webp" alt="Sebaxsus Photo">

    <nav class="flex flex-row gap-x-10 opacity-80 max-[550px]:gap-x-2">
        <a href="#top" class={ancorStyle}>Inicio</a>
        <a href="#sobre-mi" class={ancorStyle}>Sobre mi</a>
        <a href="#proyectos" class={ancorStyle}>Proyectos</a>
        <a href="#contacto" class={ancorStyle}>Contacto</a>
    </nav>
</header>