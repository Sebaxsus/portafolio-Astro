---
interface Props {
    date: string;
    title: string;
    description: string;
    Link: string;
}

const { date, title, description, Link } = Astro.props;
---

<div
    class="
    absolute w-3 h-3 bg-gray-200 rounded-full mt-1.5 -start-1.5 border border-white dark:border-gray-900 dark:bg-gray-700
    "
>
</div>
<section class="flex flex-col text-center">
    <h3 class="text-lg font-semibold text-green-400 dark:text-white">
        {title}
    </h3>
    <time
        class="mt-2 text-sm font-normal leading-none text-sky-300 dark:text-sky-200"
        >{date}</time
    >
</section>
<section class="flex flex-col">
    <p class="mb-4 text-base font-normal text-gray-200 dark:text-gray-400 text-pretty indent-4">
        {description}
    </p>
    
    {
        Link && (
            <a
                href={Link}
                class="inline-flex items-center px-4 py-2 text-sm font-medium bg-[#106a6d] w-fit rounded-full text-gray-100 hover:text-rose-100/60 focus:z-10 focus:ring-4 focus:outline-none focus:text-green-700 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-700 dark:focus:ring-gray-700"
            >
                Saber Mas...{" "}
                <svg
                    class="w-3 h-3 ms-2 rtl:rotate-180"
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 14 10"
                >
                    <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M1 5h12m0 0L9 1m4 4L9 9"
                    />
                </svg>
            </a>
        )
    }
</section>

