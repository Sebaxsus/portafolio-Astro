import SQLiteLogo from './icons/SQLiteLogo.astro'
import AHKLogo from './icons/AHKLogo.astro'
import PytestLogo from './icons/PytestLogo.astro'

import Scrollable from './Scrollable.astro'
 
const TAGS = {
