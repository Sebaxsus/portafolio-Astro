        class: "bg-white/5 text-white shadow-white",
        icon: (AHKLogo)
    },
    PYTEST: {
        name: "Pytest",
        class: "bg-white/5 text-[#90D4F4] shadow-[#90D4F4]",
        icon: (PytestLogo)
    }
}
const PROYECTS = [
    
    {
        title: 'Dashboard para el Sensor de Gas MQ4',
        description: ['Desarrolle una pagina en Astro.js con React para mostrar y filtrar los datos en tiempo real.', 'Esta pagina web se enfoca en ayudar a monitorear la cantidad de gas metano de manera remota.', 'Usa frameworks como Astro.js y React.js con una Conexion a un Servidor WebSocket.'],
        link: 'https://github.com/Sebaxsus/PaginaDashboardSensor',
        github: 'https://github.com/Sebaxsus/PaginaDashboardSensor',
        image: 'Pagina_DashBoard.webp',
        tags: [TAGS.ASTRO, TAGS.REACT, TAGS.HTML, TAGS.JS, TAGS.CSS, TAGS.TAILWIND]
    },
    {
        title: 'Servidor WebSocket en Python',
        description: ['Desarrolle un servidor WebSocket en Python para almacenar los datos de el Sensor en tiempo real e Interconectar el Sensor con un Dashboard.', 'Se usan tecnicas de Paginación desde el Motor de Base de datos, Optimización de Peticiones (Queries) teniendo en cuenta el tipo de escaneo y WebHooks para Actualizar el dashboard en tiempo real.', 'Como herramienta de Depuracion se uso Logger'],
        link: 'https://github.com/Sebaxsus/ESP32-PythonWebSocketServer',
        github: 'https://github.com/Sebaxsus/ESP32-PythonWebSocketServer',
        image: 'Servidor_WebSocket_Python.webp',
        tags: [TAGS.PYTHON, TAGS.SQLITE, TAGS.PYTEST]
    },
    {
        title: 'Script para Saltar Anuncion en YouTube',
        description: ['Desarrolle un Script para Automatizar el comportamiento de Saltar un Anuncion en YouTube.', 'El Script esta en 3 Lenguajes Distintos, JavaScript como Extension de Chrome, AHK (AutoHotKey) y Python (Playwright usando CDP Chrome DevTools Port).', 'Como herramienta de Debug use Logger de Python.'],
        link: 'https://github.com/Sebaxsus/Script_Skip_Ad_Chrome',
        github: 'https://github.com/Sebaxsus/Script_Skip_Ad_Chrome',
        image: 'Script_Saltar_Anuncios_YT.webp',
        tags: [TAGS.JS, TAGS.AHK, TAGS.PYTHON]
    },
    {
        title: 'Bot de Musica Discord',
        description: ['Desarrolle un bot para discord con el cual reproducir musica para un canal de voz en discord usando python.', 'Este proyecto implementa librerias y paquetes como Discord.py, functools, asyncio I/O, HTTPS, YTDLP, Concurent.future, Typing.'],
        link: '',
        github: '',
        image: 'ProyectoBot.webp',
        tags: [TAGS.PYTHON, TAGS.DC, TAGS.HTML, TAGS.JS]
    },
    {
        title: "Pagina animes y mangas vistos",
        description: 
            [
                "Desarrolle una pagina en react y su servidor con API REST STATELESS para poder guardar los animes o mangas usando el titulo, descripcion, imagen, generos y los capitulos disponibles, Ademas utiliza un sistema de login.",
                "autenticacion, Todos los datos se guardan en MySQL validando los datos tanto en el cliente como en el servidor usando ZOD, El sistema de tokens se hace validando credenciales y encriptando los datos intentando simular OAuth2 Utiliza react con Wouter y axios."
            ],
        link: "",
        github: "https://github.com/Sebaxsus/MiPaginaReact",
        image: 'Pagina_Animes_Mangas.webp',
        tags: [TAGS.REACT, TAGS.TAILWIND, TAGS.JS, TAGS.EXPRESS, TAGS.MYSQL, TAGS.NODE]
    },
    {
        title: "Proyecto JoyStick, Colectivo y Pedales",
        description: [
            'Desarrolle un HID (Human Interface Device) para controlar un Helicoptero en un Simulador usando Arduino como micro-controlador y Encoders, Potenciometros y Sensores Efecto Hall.',
            'Con el fin de mejorar la precisión al momento de simular un vuelo en Helicoptero.'
        ],
        link: '',
        github: '',
        image: 'Proyecto_Simulador_De_Vuelo.webp',
        tags: [TAGS.CPP, TAGS.ARDUINO]
    },
    {
        title: "Aplicacion de Alarma en Python",
        description: ["Desarrolle una aplicacion en Python para configurar una alarma y que el audio de dicha alarma se pueda escojer. Esta aplicacion se Desarrollo en Python usando Librerias como PyTube, TKinter y urllib"],
        link: '',
        github: '',
        image: 'Alarma_Python.webp',
        tags: [TAGS.PYTHON]
    },
    {
        title: "Proyecto Reloj Digital en Arduino",
        description: ["Desarrolle un reloj digital con Arduino usando un Display siete segmentos, En este proyecto se uso Arduino, C++."],
        link: '',
        github: '',
        image: 'ProyectoBot.webp',
        tags: [TAGS.CPP, TAGS.ARDUINO]
    },
    {
        title: "Portafolio",
        description: ["Desarrolle el portafolio para mostrar lo que ha sido mi experiencia como estudiante de Ingenieria de Software, Esta aplicacion web se realizo usando Astro, CSS, TailwindCSS 4.0 y JavaScript"],
        link: '',
        github: '',
        image: 'Portfolio.webp',
        tags: [TAGS.ASTRO, TAGS.TAILWIND, TAGS.HTML, TAGS.JS, TAGS.CSS]
    }

]
---

<style>
    /* Scrollbar Styling */
    #description-section::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    #description-section::-webkit-scrollbar-track {
        background: none;
        backdrop-filter: blur(10px);
        border-radius: 4px;
    }

    #description-section::-webkit-scrollbar-thumb {
        background: #00165ee6;
        border-radius: 4px;
    }
</style>

{
    PROYECTS.map(({ title, description, link, github, image, tags}, index) => (
        <article class="flex flex-row flex-1 gap-x-6 mb-6 items-center max-[550px]:flex-col">
            <a 
                href={github ? github : "https://github.com/Sebaxsus"}
                rel="noreferrer"
                target="_blank"
                class=
                "
                    rounded-lg shadow-2xl shadow-white/15 object-cover object-top 
                    w-min h-48 
                    transition duration-500 
                    hover:scale-105 
                    sm:aspect-square 
                    md:aspect-[15/10] 
                    lg:aspect-video 
                    cursor-pointer
                "
            >
                <img class=
                "
                    rounded-lg shadow-2xl shadow-white/15 object-cover object-top 
                    w-min h-48 
                    transition duration-500 
                    hover:scale-105 
                    sm:aspect-square 
                    md:aspect-[15/10] 
                    lg:aspect-video 
                    cursor-pointer
                " src={image} alt={`Imagen de ${title}`}
                />
            </a>
            <aside class="flex flex-col gap-y-4  ">
                <h3 
                    class=
                    "
                        text-2xl font-semibold text-green-400 
                        my-2 
                        max-[550px]:[font-size:25px] max-[550px]:text-center
                    "
                    >
                    {title}
                </h3>
                
                <section 
                    class=
                    "
                        relative
                        flex flex-col gap-y-7
                        px-1
                        pt-1
                        max-h-[140px]
                        overflow-y-auto
                        snap-y
                        snap-mandatory
                    "
                    id="description-section"
                >
                    {description.map((descript) => (
                            <p 
                                class=
                                "
                                    text-base text-pretty 
                                    max-[550px]:[font-size:15px]
                                "
                            >
                                {descript}
                            </p>
                        ))
                    }
                    <Scrollable extraStyle='pb-2'/>
                </section>

                <ul class="grid grid-cols-2 gap-x-1 gap-y-2 mb-2" id="projectTec">
                    {tags.map((tag) => (
                        <li class="">
                            <span class={`
                                    flex gap-x-2 rounded-3xl 
                                    text-xs [box-shadow:2px_3px_10px_-2px]
                                    ${tag.class} 
                                    py-2 px-3 items-center cursor-default
                                    hover:bg-white/5 hover:scale-110 transition
                                    max-[550px]:w-max
                                    [text-shadow:0px_0px_16px_#000000;]
                                `}
                            >
                                <tag.icon class="size-6"/>
                                {tag.name}
                            </span>
                        </li>
                    ))}
                </ul>
            </aside>
            
        </article>
    ))
}