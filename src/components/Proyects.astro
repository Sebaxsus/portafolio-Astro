---
import PythonLogo from './icons/PythonLogo.astro'
import HTMLLogo from './icons/HTMLLogo.astro'
import JSLogo from './icons/JSLogo.astro'
import CSSLogo from './icons/CSSLogo.astro'
import TailwindCSS from './icons/TailwindCSSLogo.astro'
import DiscordJS from './icons/DCJSLogo.astro'
import CPP from './icons/CPP.astro'
import AstroLogo from './icons/AstroLogo.astro'
import ArduinoLogo from './icons/arduino.astro'
import ReactLogo from './icons/ReactLogo.astro'
import ZodLogo from './icons/Zod.astro'
import MySQLLogo from './icons/MySQL.astro'
import ExpressLogo from './icons/ExpressLogo.astro'
