---
<style>
    #carousel {
        box-shadow: 10px 5px 20px 3px #;
    }
    /* Scrollbar Styling */
    #carousel::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    #carousel::-webkit-scrollbar-track {
        background: none;
        backdrop-filter: blur(10px);
        border-radius: 4px;
    }

    #carousel::-webkit-scrollbar-thumb {
        background: #3b9ed3e6;
        border-radius: 4px;
    }
</style>

<script>
    // Utilizo esta funcion para que los bloque de validacion con return
    // No me den error de return global, Ya que esto se ejecuta como script
    // y no como modulo js con ambito propio.

    // En Js del navegador no se puede usar un return en el nivel superior de un script
    // Unicamente dentro de funciones.
    function initCarousel() {
        const container = document.getElementById('carousel')
        const DELAY = 3000
        const START_ITEM = 0
    
        if (!container) {
            console.error("No se pudo encontrar el elemento con id carousel")
            return
        }
        
        if (!container.dataset.certs) {
            console.error("No se encontro el data set CERTS dentro del elemento corousel!")
            return
        }
    
        const containerWidth = container.offsetWidth
    
        const CERTIFICATES: Array<string> = container.dataset.certs.split(',')
    
        const scrollLimit = containerWidth * (CERTIFICATES.length - 1)
    
        const moveCarousel = (carouselItem: number) => {
            // console.log('Movimineto'+ x)
            
            if (container.scrollLeft < scrollLimit) {
                container.scroll(
                {
                    top: 0,
                    left: (containerWidth * carouselItem),
                    behavior: 'smooth',
                })
                carouselItem += 1
            } else {
                container.scroll({
                    top: 0,
                    left: 0,
                    behavior: "smooth",
                })
                carouselItem = 1
            }
            
            setTimeout(moveCarousel, DELAY, carouselItem)
        }
    
        moveCarousel(START_ITEM)
    }

    initCarousel()
</script>

