---
const IMG = [
    {url: 'FotoBotDC.png'},
    {url: 'LogoUNAB.png'},
    {url: 'Mirada_A_Centro.jpg'},
    {url: 'ProyectoBot.webp'}

]

const CERTS = [
    {url: 'certs/CertificadoIA_UDFranciscoJoseDeCaldas.pdf'},
    {url: 'certs/CertificadoPythonMintic.pdf'},
    {url: 'certs/TecnicoLaboral.pdf'},
    {url: 'certs/Programacion Basica Java.pdf'},
    {url: 'certs/MisionTic2022.pdf'},
    {url: 'certs/Networking_Devices_and_Initial_Configuration_Badge20240208-29-wrriuk.pdf'},
]
---
<style>
    #carousel {
        box-shadow: 10px 5px 20px 3px #;
    }
    /* Scrollbar Styling */
    #carousel::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    #carousel::-webkit-scrollbar-track {
        background: none;
        backdrop-filter: blur(10px);
        border-radius: 4px;
    }

    #carousel::-webkit-scrollbar-thumb {
        background: #3b9ed3e6;
        border-radius: 4px;
    }
</style>

<script>
    const container = document.getElementById('carousel')
    const limit = container.offsetWidth * (container.dataset.certs.split(',').length - 1)
    moveCarousel(0)


    function moveCarousel(x) {
        // console.log('Movimineto'+ x)
        
        //Cambiar esto para que sea dinamico y cuando llegue al tope
        //Se ponga en 0
        if (container.scrollLeft < limit) {
            container.scroll(
            {
                top: 0,
                left: (container?.offsetWidth * x),
                behavior: 'smooth',
            })
            x += 1
        } else {
            container.scroll({
                top: 0,
                left: 0,
                behavior: "smooth",
            })
            x = 1
        }
        
        setTimeout(moveCarousel, 3000,x)
    }
    
</script>

