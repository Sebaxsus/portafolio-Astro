<main class="flex overflow-x-scroll overflow-y-hidden [scroll-snap-type:x_mandatory] scroll-smooth gap-4 first:snap-start aspect-[2/1] motion-reduce:scroll-auto items-center rounded-xl backdrop-blur-md shadow-sky-700/90" id="carousel" data-certs={CERTS}>
    {CERTS.map((cert, index) => {
        return (
            <embed src={cert.url} type="application/pdf" height="100%" width="100%" id={`carouselItem${index}`} class="flex [flex:0_0_100%] snap-always snap-center overflow-hidden object-cover transition"/>
        )
    })}
</main>