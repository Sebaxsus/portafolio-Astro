---
interface Props {
    extraStyle?: string,
}

const { extraStyle } = Astro.props
---

<style>
    .arrow {
        padding-top: 2px;
        width: 20px;
        height: 20px;
        border-left: 2px solid rgb(48, 145, 255);
        border-bottom: 2px solid rgb(48, 145, 255);
        transform: rotate(-45deg);
        margin: 0 auto;
        animation: bounce 1.5s infinite;
    }

    @keyframes bounce {
        0%, 20%, 50%, 80%, 100% {
            transform: translateY(0) rotate(-45deg);
        }
        40% {
            transform: translateY(10px) rotate(-45deg);
        }
        60% {
            transform: translateY(5px) rotate(-45deg);
        }
    }
</style>

<!-- bg #6262624f -->
<div class={`arrow-container sticky bottom-0 w-full h-10 [mask-image:linear-gradient(to_top,black_30%,transparent_80%)] hidden ${extraStyle}`} id="arrow-container">
    <div class="arrow"></div>
</div>

<script>
    const arrowContainer = document.querySelectorAll(".arrow-container").forEach((arrow) => {
        const parent = arrow.parentElement

        if (!parent) return

        const isScrollable = parent.scrollHeight > parent.clientHeight

        arrow.classList.toggle('hidden', !isScrollable)

        if (!isScrollable) return

        parent.addEventListener('scroll', () => {
            const atBottom = parent.scrollTop >= parent.scrollHeight - parent.offsetHeight - 20
            arrow.classList.toggle('hidden', atBottom)
        })
    })
</script>