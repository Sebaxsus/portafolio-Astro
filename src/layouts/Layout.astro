---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "@fontsource-variable/onest";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Portfolio de Sebaxsus - Desarrollador y Programador</title>
		<meta name="description" content="
		Contrate a Sebaxsus para crear aplicaciones web.
		Desarrollador Web.		
		">
	</head>
	<body class="relative">
		<div class="absolute top-0 z-[-2] h-full w-full bg-[#000000] bg-[radial-gradient(#ffffff33_1px,#00091d_1px)] bg-[size:20px_20px]"></div>
		<Header />
		<slot />
		<Footer />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light dark;
	}
	html {
		font-family:
			"Onest Variable",
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			Roboto,
			Oxygen,
			Ubuntu,
			Cantarell,
			"Open Sans",
			"Helvetica Neue",
			sans-serif
		;
		scroll-behavior: smooth;
	}
	body {
		background-color: #050505;
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 100vh;
		scrollbar-gutter: stable;
		/*width: fit-content;
		/**/
	}

	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}

	@media only screen and (max-width: 500px) {
		body {
			width: fit-content;
			text-size-adjust: auto;
		}
		
		#top {
			width: max-content;
		}
	}
</style>


