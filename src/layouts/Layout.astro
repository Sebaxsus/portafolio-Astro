---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import '../styles/global.css';
import "@fontsource-variable/onest";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" style="width: fit-content;" />
		<meta name="generator" content={Astro.generator} />
		<title>Portfolio de Sebaxsus - Desarrollador y Programador</title>
		<meta name="description" content="
		Contrate a Sebaxsus para crear aplicaciones web.
		Desarrollador Web.		
		">
	</head>
	<body class="relative">
		<div class="absolute top-0 z-[-2] h-full w-full bg-[#000000] bg-[radial-gradient(#ffffff33_1px,#00091d_1px)] bg-[size:20px_20px]"></div>
		<Header />
		<slot />
		<Footer />
	</body>
</html>